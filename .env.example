# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Note: These are client-side variables and are prefixed with VITE_
# Use a publishable key (sb_publishable_...). Database access must be protected by RLS.
# Never put a secret or service-role key in a VITE_ variable.
